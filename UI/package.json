{
  "name": "my-nuxt-layer",
  "type": "module",
  "version": "0.0.1",
  "main": "./nuxt.config.ts",
  "scripts": {
    "init": "npm i",
    "dev:type": "npm-run-all --parallel build:icons build:scss-types",
    "dev": "nuxi dev .playground",
    "dev:prepare": "nuxt prepare .playground",
    "build": "nuxt build .playground",
    "generate": "nuxt generate .playground",
    "preview": "nuxt preview .playground",
    "build:icons": "npx tsx utils/icon/build-icons.mts",
    "build:scss-types": "typed-scss-modules */**/{ui,css}.scss --exportType default --exportTypeInterface IStyles --nameFormat none --outputFolder type/CSS --watch"
  },
  "dependencies": {
    "@nuxtjs/svg-sprite": "^1.0.2",
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
    "chokidar": "^3.6.0",
    "normalize.css": "^8.0.1",
    "npm-run-all": "^4.1.5",
    "nuxt": "^3.6.1",
    "postcss-html": "^1.6.0",
    "sass": "^1.72.0",
    "typed-scss-modules": "^8.0.1",
    "v-calendar": "^3.1.2"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.12.1",
    "@types/fs-extra": "^11.0.4",
    "autoprefixer": "^10.4.20",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "node-html-parser": "^6.1.13",
    "postcss": "^8.4.45",
    "typescript": "^5.6.2"
  }
}
